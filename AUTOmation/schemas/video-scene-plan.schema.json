{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Video Scene Plan",
  "description": "Schema for a video scene plan — bridges transcription to animated rendering",
  "type": "object",
  "required": ["content_item_id", "scenes", "created_at", "updated_at"],
  "properties": {
    "content_item_id": {
      "type": "string",
      "description": "Reference to the content item"
    },
    "title": {
      "type": "string",
      "description": "Scene plan title"
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scene_id", "start_time", "end_time", "visual_type"],
        "properties": {
          "scene_id": {
            "type": "string",
            "description": "Unique scene identifier"
          },
          "start_time": {
            "type": "number",
            "description": "Start time in seconds"
          },
          "end_time": {
            "type": "number",
            "description": "End time in seconds"
          },
          "duration": {
            "type": "number",
            "description": "Scene duration in seconds"
          },
          "visual_type": {
            "type": "string",
            "enum": ["manim", "mermaid", "remotion", "stock footage", "b-roll", "text overlay"],
            "description": "Type of visual for this scene"
          },
          "text": {
            "type": "string",
            "description": "Text to display in this scene"
          },
          "narration_text": {
            "type": "string",
            "description": "Voice-over text for this scene"
          },
          "animation_params": {
            "type": "object",
            "description": "Parameters specific to the animation type"
          },
          "transition": {
            "type": "string",
            "description": "Transition type to the next scene"
          }
        }
      },
      "description": "Ordered list of scenes"
    },
    "render_engine": {
      "type": "string",
      "enum": ["manim", "remotion", "mermaid", "blended"],
      "description": "Primary rendering engine for this scene plan"
    },
    "style_guide": {
      "type": "string",
      "description": "Brand style guide reference for this rendering"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
