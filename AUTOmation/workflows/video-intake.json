{
  "name": "Video Intake - AUTOmation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "video-intake"
      },
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 340]
    },
    {
      "parameters": {
        "functionCode": "return [\n  {\n    json: {\n      video_path: items[0].json.body.video_path,\n      source_metadata: items[0].json.body,\n      transcript_path: items[0].json.body.video_path.replace('.mp4', '.json'),\n      scene_plan_path: items[0].json.body.video_path.replace('.mp4', '.scene.json'),\n    }\n  }\n];"
      },
      "name": "Extract Metadata",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [480, 340]
    },
    {
      "parameters": {
        "url": "={{ $env.CONTENT_API_URL }}/content",
        "method": "POST",
        "body": {
          "source_type": "recording",
          "source_path": "={{ $json.video_path }}",
          "title": "={{ $json.source_metadata.title || 'Untitled Recording' }}"
        },
        "options": {}
      },
      "name": "Create Content Item",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [720, 340]
    },
    {
      "parameters": {
        "url": "={{ $env.TRANSCRIPTION_API_URL }}/transcribe",
        "method": "POST",
        "body": {
          "input": "={{ $json.video_path }}",
          "model": "small"
        },
        "options": {
          "headers": {
            "Content-Type": "application/json"
          }
        }
      },
      "name": "Run Transcription",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [720, 480]
    },
    {
      "parameters": {
        "url": "={{ $env.SUBTITLE_API_URL }}/generate",
        "method": "POST",
        "body": {
          "transcript": "={{ $jsonRunTranscription.text }}",
          "target_formats": ["srt", "vtt"]
        },
        "options": {}
      },
      "name": "Generate Captions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [720, 600]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Extract Metadata",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Metadata": {
      "main": [
        [
          {
            "node": "Create Content Item",
            "type": "main",
            "index": 0
          },
          {
            "node": "Run Transcription",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "timezone": "Africa/Kampala"
  },
  "versionId": "2"
}
